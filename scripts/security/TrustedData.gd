\\u043c\\u044c \\u0444\\u0440\\u0430\\u043a\\u0446\\u0438\\u0439 \\u043a\\u043b\\u044f\\u0442\\u0432\\u0430\\u043c\\u0438 \\u0438\\u043b\\u0438 \\u0441\\u0438\\u043b\\u043e\\u0439. \\u041d\\u0430\\u0447\\u043d\\u0438\\u0442\\u0435 \\u0441 \\u043c\\u0435\\u0447\\u0430 [I], \\u043f\\u043e\\u043b\\u0435\\u0439 [R \\u2192 \\u0441\\u0442\\u0440\\u043e\\u0438\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u043e] \\u0438 \\u0441\\u0442\\u0430\\u0440\\u043e\\u0441\\u0442\\u044b \\u0422\\u0438\\u0445\\u043e\\u0439 \\u0421\\u0435\\u0447\\u0438 \\u043d\\u0430 \\u0441\\u0435\\u0432\\u0435\\u0440\\u0435. \\u041a\\u0430\\u0440\\u0442\\u0430 [M] \\u0438 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b [J] \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u043f\\u043e\\u0434 \\u0440\\u0443\\u043a\\u043e\\u0439.\"},\"ui.campaign_progress\":{\"en\":\"Oaths: {regions}/8 \\u00b7 Quests: {quests}/60\",\"ru\":\"\\u041a\\u043b\\u044f\\u0442\\u0432\\u044b: {regions}/8 \\u00b7 \\u0417\\u0430\\u0434\\u0430\\u043d\\u0438\\u044f: {quests}/60\"},\"ui.campaign_summary\":{\"en\":\"Build your settlement. Unite the March through diplomacy or war.\",\"ru\":\"\\u041e\\u0442\\u0441\\u0442\\u0440\\u043e\\u0439\\u0442\\u0435 \\u043f\\u043e\\u0441\\u0435\\u043b\\u0435\\u043d\\u0438\\u0435. \\u041e\\u0431\\u044a\\u0435\\u0434\\u0438\\u043d\\u0438\\u0442\\u0435 \\u043f\\u043e\\u0433\\u0440\\u0430\\u043d\\u0438\\u0447\\u044c\\u0435 \\u2014 \\u0441\\u043b\\u043e\\u0432\\u043e\\u043c \\u0438\\u043b\\u0438 \\u043c\\u0435\\u0447\\u043e\\u043c.\"},\"ui.close\":{\"en\":\"Close\",\"ru\":\"\\u0417\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c\"},\"ui.companions\":{\"en\":\"Companions\",\"ru\":\"\\u0421\\u043f\\u0443\\u0442\\u043d\\u0438\\u043a\\u0438\"},\"ui.continue\":{\"en\":\"Continue campaign\",\"ru\":\"\\u041f\\u0440\\u043e\\u0434\\u043e\\u043b\\u0436\\u0438\\u0442\\u044c \\u043a\\u0430\\u043c\\u043f\\u0430\\u043d\\u0438\\u044e\"},\"ui.continue_world\":{\"en\":\"Continue exploring\",\"ru\":\"\\u041f\\u0440\\u043e\\u0434\\