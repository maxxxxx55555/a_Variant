; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/version="1.2.0"

run/max_fps=60
config/name="Marchland Oaths"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Oaths of the March"
config/name_localized={
"en": "Marchland Oaths",
"ru": "Marchland Oaths"
}
config/description="Marchland Oaths - Fantasy Action RPG & Settlement Strategy"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
TimeSystem="*res://scripts/autoload/TimeSystem.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
LocalizationManager="*res://scripts/autoload/LocalizationManager.gd"
IntegrityLogger="*res://scripts/autoload/IntegrityLogger.gd"
InputManager="*res://scripts/autoload/InputManager.gd"
WorldManager="*res://scripts/autoload/WorldManager.gd"
AlchemySystem="*res://scripts/autoload/AlchemySystem.gd"
PopulationSystem="*res://scripts/systems/PopulationSystem.gd"
EconomySystem="*res://scripts/systems/EconomySystem.gd"
SettlementSystem="*res://scripts/systems/SettlementSystem.gd"
ArmySystem="*res://scripts/systems/ArmySystem.gd"
FactionSystem="*res://scripts/systems/FactionSystem.gd"
DiplomacySystem="*res://scripts/systems/DiplomacySystem.gd"
QuestSystem="*res://scripts/systems/QuestSystem.gd"
WeatherSystem="*res://scripts/systems/WeatherSystem.gd"
CampaignSystem="*res://scripts/systems/CampaignSystem.gd"
WorkshopSystem="*res://scripts/systems/WorkshopSystem.gd"
SiegeSystem="*res://scripts/systems/SiegeSystem.gd"

[display]

window/vsync/vsync_mode=0

window/size/window_width_override=1280
window/size/window_height_override=720

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

