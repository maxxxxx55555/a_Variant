; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited directly for basic parameters.

config_version=5

[application]

config/name="Oaths of the March"
config/name_localized={
"en": "Oaths of the March",
"ru": "Клятвы Пограничья"
}
config/description="Oaths of the March / Клятвы Пограничья - Fantasy Action RPG & Settlement Strategy"
run/main_scene="res://scenes/world/test_location.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/GameState.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
TimeSystem="*res://scripts/autoload/TimeSystem.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
LocalizationManager="*res://scripts/autoload/LocalizationManager.gd"
IntegrityLogger="*res://scripts/autoload/IntegrityLogger.gd"
InputManager="*res://scripts/autoload/InputManager.gd"
WorldManager="*res://scripts/autoload/WorldManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

